#!/bin/bash
# Omarchy theme-set hook: restart the aquarium so it re-reads the new theme's
# colours. Does nothing unless the aquarium is currently running.

command -v omarchy-aquarium-toggle >/dev/null || exit 0
omarchy-aquarium-toggle status >/dev/null 2>&1 || exit 0

omarchy-aquarium-toggle off
omarchy-aquarium-toggle on
