#!/bin/bash
# Turn the animated aquarium background on or off.
#
#   omarchy-aquarium-toggle [toggle|on|off|status|restore|restart|startle]
#
# Executables in ~/.config/omarchy-aquarium/hooks/ are run (detached, with "on"
# or "off" as $1) whenever the tank goes on or off, for anything that has to
# re-read the screen afterwards.
#
# "restore" is what a session autostart calls: it starts the tank unless it was
# deliberately turned off in an earlier session (the on/off state outlives a
# reboot; an unwritten state means on).
#
# Extra flags for the renderer can be put, one per line or space separated, in
#   ~/.config/omarchy-aquarium/options
# for example:  --fish 14 --jelly 5 --anemone 3 --turtle 0 --speed 0.8 --fps 24
#
# Unless the options contain --no-react, a watcher is started alongside the
# renderer that startles the tank on desktop notifications
# (omarchy-aquarium-notify); "startle" pokes the fish by hand.

set -uo pipefail

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-aquarium.pid"
NOTIFY_PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-aquarium-notify.pid"
LOGFILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-aquarium.log"
CTLFILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-aquarium.ctl"
OPTIONS_FILE="$HOME/.config/omarchy-aquarium/options"
HOOK_DIR="$HOME/.config/omarchy-aquarium/hooks"
STATEFILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-aquarium/enabled"

DEFAULT_ARGS=(--theme --fps 60)

# Remember on/off across sessions, so a login can put the tank back exactly as
# it was left. A failure to write it must never break the toggle itself.
remember() {
	# A restart on the machine's behalf (the theme hook) is not the user
	# saying "off", so it leaves the remembered state alone.
	[[ ${KEEP_STATE:-0} == 1 ]] && return 0
	mkdir -p "${STATEFILE%/*}" 2>/dev/null && printf '%s\n' "$1" >"$STATEFILE" 2>/dev/null
	return 0
}

# Turning the tank on or off repaints the whole screen, and anything that
# reacts to what is on screen has no way to hear about it: the pid file sits in
# the runtime dir and nothing watches it. On this machine that shows up as the
# transparent bar keeping black text over blue water until its 5-minute timer
# comes round. Hooks get the new state as $1 and run detached -- the keybind
# must not wait for them.
run_hooks() {
	# An internal restart is not a state change; neither the state file nor
	# the hooks should see one.
	[[ ${KEEP_STATE:-0} == 1 ]] && return 0
	[[ -d $HOOK_DIR ]] || return 0
	local h
	for h in "$HOOK_DIR"/*; do
		[[ -f $h && -x $h ]] || continue
		setsid "$h" "$1" >/dev/null 2>&1 &
	done
	return 0
}

notify() {
	command -v notify-send >/dev/null || return 0
	notify-send -a "Aquarium" -t 2000 "$1" "${2-}"
}

running_pid() {
	local pid
	[[ -r $PIDFILE ]] || return 1
	pid=$(<"$PIDFILE")
	[[ -n $pid ]] || return 1
	# Make sure the pid was not recycled by some other program.
	[[ $(tr -d '\0' </proc/"$pid"/comm 2>/dev/null) == omarchy-aquari* ]] || return 1
	echo "$pid"
}

start() {
	remember on
	if running_pid >/dev/null; then
		return 0
	fi
	local args=("${DEFAULT_ARGS[@]}")
	if [[ -r $OPTIONS_FILE ]]; then
		# shellcheck disable=SC2207
		args=($(grep -v '^[[:space:]]*#' "$OPTIONS_FILE" | tr '\n' ' '))
	fi
	setsid omarchy-aquarium "${args[@]}" >"$LOGFILE" 2>&1 &
	echo $! >"$PIDFILE"
	if [[ " ${args[*]} " != *" --no-react "* ]] \
	   && command -v omarchy-aquarium-notify >/dev/null; then
		setsid omarchy-aquarium-notify >/dev/null 2>&1 &
		echo $! >"$NOTIFY_PIDFILE"
	fi
	notify "Aquarium on"
	run_hooks on
}

stop() {
	remember off
	if [[ -r $NOTIFY_PIDFILE ]]; then
		# The pid is the script; the dbus-monitor it spawned shares its
		# session (setsid), so take down the whole group.
		kill -- -"$(<"$NOTIFY_PIDFILE")" 2>/dev/null
		rm -f "$NOTIFY_PIDFILE"
	fi
	local pid
	pid=$(running_pid) || { rm -f "$PIDFILE"; run_hooks off; return 0; }
	kill "$pid" 2>/dev/null
	rm -f "$PIDFILE"
	notify "Aquarium off"
	run_hooks off
}

case "${1:-toggle}" in
	on)     start ;;
	off)    stop ;;
	restore)
		# At login: no notification (the tank has not "just been turned on",
		# and a bubble at boot would startle it in its first second).
		[[ $(cat "$STATEFILE" 2>/dev/null) == off ]] && exit 0
		notify() { :; }
		start
		;;
	toggle) if running_pid >/dev/null; then stop; else start; fi ;;
	restart)
		# For hooks: pick up new colours without changing on/off.
		running_pid >/dev/null || exit 0
		KEEP_STATE=1
		notify() { :; }
		stop
		start
		;;
	status)
		if pid=$(running_pid); then
			echo "running (pid $pid)"
		else
			echo "stopped"
			exit 1
		fi
		;;
	startle)
		[[ -p $CTLFILE ]] && timeout 0.5 bash -c "printf 'startle\n' > '$CTLFILE'"
		;;
	*)
		echo "usage: ${0##*/} [toggle|on|off|status|restore|restart|startle]" >&2
		exit 2
		;;
esac
